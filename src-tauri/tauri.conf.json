{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Expense Tracker",
  "version": "0.1.1",
  "identifier": "com.nrcms.expense-tracker-v2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Expense Tracker",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "default",
          "description": "all default capabilities for all windows",
          "windows": ["*"],
          "permissions": [
            "core:default",
            "opener:default",
            "store:default",
            "updater:default",
            "process:default",
            "core:webview:allow-create-webview-window",
            "core:event:allow-listen",
            "dialog:allow-open",
            "dialog:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNCMTk5MURFMkY1NzAwOTUKUldTVkFGY3YzcEVaTzdxOGZnOUU5QVRrcmMwUC90akZCc1JVNXJNK0RyZ0ZEYzRTelM1OGhNS00K",
      "endpoints": [
        "https://github.com/nikcich/ExpenseTrackerV2/releases/latest/download/latest.json"
      ],
      "installMode": "passive"
    }
  }
}
